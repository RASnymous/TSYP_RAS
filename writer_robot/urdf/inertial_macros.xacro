<?xml version="1.0"?>
<!--
  inertial_macros.xacro  -  reusable, physically-correct inertia tensors.

  Using real inertia formulas (instead of hand-typed guesses) keeps the
  robot numerically stable in Gazebo: the diff-drive won't jitter, the
  robot won't tip from a bad centre of mass, and the trapdoor servo joint
  behaves like a real actuator. Every solid uses its exact tensor.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Solid box centred at the link origin -->
  <xacro:macro name="inertial_box" params="mass x y z *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${mass}"/>
      <inertia
        ixx="${(mass/12.0)*(y*y + z*z)}" ixy="0.0" ixz="0.0"
        iyy="${(mass/12.0)*(x*x + z*z)}" iyz="0.0"
        izz="${(mass/12.0)*(x*x + y*y)}"/>
    </inertial>
  </xacro:macro>

  <!-- Solid cylinder, symmetry axis along local Z -->
  <xacro:macro name="inertial_cylinder" params="mass radius length *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${mass}"/>
      <inertia
        ixx="${(mass/12.0)*(3.0*radius*radius + length*length)}" ixy="0.0" ixz="0.0"
        iyy="${(mass/12.0)*(3.0*radius*radius + length*length)}" iyz="0.0"
        izz="${(mass/2.0)*(radius*radius)}"/>
    </inertial>
  </xacro:macro>

  <!-- Solid sphere -->
  <xacro:macro name="inertial_sphere" params="mass radius *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${mass}"/>
      <inertia
        ixx="${(2.0/5.0)*mass*radius*radius}" ixy="0.0" ixz="0.0"
        iyy="${(2.0/5.0)*mass*radius*radius}" iyz="0.0"
        izz="${(2.0/5.0)*mass*radius*radius}"/>
    </inertial>
  </xacro:macro>

</robot>
