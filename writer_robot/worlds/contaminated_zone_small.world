<?xml version="1.0"?>
<!-- ORIGINAL small arena (kept for quick tests: world:=.../contaminated_zone_small.world).
     Gazebo Jetty (gz-sim) world for the Writer Robot.
     Loads the system plugins the robot needs (physics, scene broadcaster,
     user-commands for spawn/create, sensors with rendering, imu), an inline
     sun + ground plane (no Fuel download needed), a collapsed-corridor maze,
     and the magenta/red hazard markers the camera CV detects. -->
<sdf version="1.9">
  <world name="contaminated_zone">

    <!-- system plugins -->
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>

    <!-- 4 ms step (250 Hz) instead of 1 ms: ~4x less physics CPU, plenty
         accurate for this demo and much smoother inside a VM. -->
    <physics name="4ms" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <gravity>0 0 -9.81</gravity>

    <!-- lighting -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.3 -1</direction>
    </light>

    <!-- ground plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>50 50</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>50 50</size></plane></geometry>
          <material>
            <ambient>0.4 0.4 0.4 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============ Structure: collapsed / contaminated corridors ======= -->
    <model name="wall_1">
      <static>true</static><pose>2 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 6 1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 6 1</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_2">
      <static>true</static><pose>-2 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 6 1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 6 1</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_3">
      <static>true</static><pose>0 3 0.5 0 0 1.5708</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 4 1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 4 1</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_4">
      <static>true</static><pose>0 -3 0.5 0 0 1.5708</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 4 1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 4 1</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_5">
      <static>true</static><pose>0.5 -0.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 3 1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 3 1</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material></visual>
      </link>
    </model>

    <!-- rubble the robot must route around -->
    <model name="rubble_1">
      <static>true</static><pose>0.8 1 0.25 0 0 0.4</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.5 0.5 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.5 0.5 0.5</size></box></geometry>
          <material><ambient>0.5 0.4 0.3 1</ambient><diffuse>0.6 0.5 0.4 1</diffuse></material></visual>
      </link>
    </model>
    <model name="rubble_2">
      <static>true</static><pose>-0.9 -1.2 0.25 0 0 -0.3</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.4 0.6 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.4 0.6 0.5</size></box></geometry>
          <material><ambient>0.5 0.4 0.3 1</ambient><diffuse>0.6 0.5 0.4 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ================= EVENT MARKERS (for camera CV) ================== -->
    <!-- Radiation source: MAGENTA post -> vision detector "radiation" -->
    <model name="radiation_source">
      <static>true</static><pose>1.3 -1.6 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.25 0.25 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.25 0.25 0.5</size></box></geometry>
          <material>
            <ambient>0.6 0.0 0.6 1</ambient><diffuse>0.9 0.0 0.9 1</diffuse>
            <emissive>0.3 0.0 0.3 1</emissive>
          </material></visual>
      </link>
    </model>
    <model name="radiation_hotzone">
      <static>true</static><pose>1.3 -1.6 0.02 0 0 0</pose>
      <link name="link">
        <visual name="visual"><geometry><cylinder><radius>1.0</radius><length>0.02</length></cylinder></geometry>
          <material><ambient>0.8 0.0 0.5 0.25</ambient><diffuse>0.8 0.0 0.5 0.25</diffuse></material></visual>
      </link>
    </model>

    <!-- Fire / heat hazard: RED post -> vision detector "fire" -->
    <model name="fire_hazard">
      <static>true</static><pose>-1.3 1.6 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.25 0.25 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.25 0.25 0.5</size></box></geometry>
          <material>
            <ambient>0.6 0.0 0.0 1</ambient><diffuse>0.95 0.05 0.05 1</diffuse>
            <emissive>0.4 0.0 0.0 1</emissive>
          </material></visual>
      </link>
    </model>

  </world>
</sdf>
