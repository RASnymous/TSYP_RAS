<?xml version="1.0"?>
<!-- GENERATED by tools/make_world.py - edit the layout there, then re-run it.
     RETREAT TEST world for the Writer Robot (small, fast on a VM): room A
     (start), room B north of it, and an L-shaped corridor with a PURPLE
     radiation block 3 m after the corner (a 0.95 m gap beside it). Once the
     camera sees it the robot must turn back the way it came, finish mapping
     and return to the start.
     World name kept as contaminated_zone so beacon spawning works. -->
<sdf version="1.9">
  <world name="contaminated_zone">

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <!-- 4 ms step: light on the CPU, smooth inside a VM -->
    <physics name="4ms" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <gravity>0 0 -9.81</gravity>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.3 -1</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>60 60</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>60 60</size></plane></geometry>
          <material><ambient>0.4 0.4 0.4 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_00">
      <static>true</static><pose>0.000 -2.000 0.500 0 0 0.0000</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>4.200 0.200 1.000</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>4.200 0.200 1.000</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_01">
      <static>true</static><pose>-2.000 0.000 0.500 0 0 1.5708</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>4.200 0.200 1.000</size></box></geometry></collision>
