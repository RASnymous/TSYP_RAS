<?xml version="1.0"?>
<!-- Placed by the Executor on a hazard it has treated: a glowing green disc on
     the floor around the block. Static, visual-only, 2 cm high (invisible to
     the LiDAR), green (outside every hazard colour gate of the camera). -->
<sdf version="1.6">
  <model name="treated_marker">
    <static>true</static>
    <link name="link">
      <visual name="disc">
        <pose>0 0 0.01 0 0 0</pose>
        <geometry><cylinder><radius>0.5</radius><length>0.02</length></cylinder></geometry>
        <material>
          <ambient>0.0 0.8 0.3 1</ambient>
          <diffuse>0.1 0.9 0.3 1</diffuse>
          <emissive>0.0 0.6 0.2 1</emissive>
        </material>
      </visual>
    </link>
  </model>
</sdf>
